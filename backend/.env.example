PORT=5000

# SAP S/4HANA credentials (secret)
SAP_BASE_URL=https://my416787-api.s4hana.cloud.sap
SAP_USER=Z_N8N_API_USER
SAP_PASS=your-sap-password-here

# Firebase Admin service account (secret).
# Paste the ENTIRE contents of the service account JSON on one line, single-quoted.
# Firebase Console > Project Settings > Service Accounts > Generate new private key.
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","private_key":"...", ...}'

# Cutover serial numbers (optional). Only serials issued AFTER the listed one may
# be received, which stops a reworked legacy pack from being backflushed twice.
# Format: material=serial, separated by ';'. Use '*' as the material for a
# default covering everything else. Unset = no serial is blocked.
# NOTE: once a material is listed here, EVERY scan on it must be in the
# MO-YYYYMM NNNNN format — a VIN or any other value is rejected outright.
# SERIAL_CUTOVER=221000022=MO-202609 45678;201000021=MO-202609 12000

# Duplicate-serial look-back window in months (default 2). Production posts with
# real dates, so the default is correct here.
# DUP_CHECK_MONTHS=2

# How far back to look for other orders when working out a material's serial
# floor (default 6 months). A new order may not start below where an earlier
# order for the same material started, so this has to reach the previous order.
# SERIAL_FLOOR_MONTHS=6
